# ==============================================================================
# LodgeMate Admin (lodgemateadmin) — Environment Configuration
# Copy to .env.local and fill with your existing LodgeMate Supabase credentials.
# NEVER commit .env.local or expose server-only keys to the browser.
# ==============================================================================

# 1. Existing LodgeMate Supabase Project (Browser + Server)
NEXT_PUBLIC_SUPABASE_URL=https://ghazkfgexrwkbzpqbqyg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 2. Server-Only Supabase Service Role Key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# 3. Shared Admin Account Defense-in-Depth Allowlist (Server-Only)
# Must match the single shared administrator account in Supabase Auth with role='admin'
ADMIN_ALLOWED_EMAIL=
# Optional extra lock: exact auth.users UUID of the shared admin account
ADMIN_ALLOWED_USER_ID=

# 4. Canonical URL of this standalone admin deployment (HTTPS required for Web Push)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# 5. Web Push VAPID Keys (Generate with: npx web-push generate-vapid-keys)
# Public key is safe for browser push subscription; private key is strictly server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@lodgemate.ng
